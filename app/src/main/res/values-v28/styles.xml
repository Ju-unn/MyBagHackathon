<?xml version="1.0" encoding="utf-8"?>
<!-- API 28(Android 9) 이상 전용 오버라이드 — android:lineHeight는 API 28부터
     지원되는 속성이라 여기서만 적용함. values/styles.xml의 같은 이름 스타일
     14종을 전부 그대로 가져오고 lineHeight만 추가한 완전한 버전임
     (부분 오버라이드가 아니라, API 28+ 기기에서는 이 파일의 정의가
     values/styles.xml 대신 통째로 사용됨). -->
<resources>

    <style name="TextAppearance.Bag.DisplayL" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">30sp</item>
        <item name="android:lineHeight">38sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/bag_text_primary</item>
    </style>

    <style name="TextAppearance.Bag.DisplayM" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">36sp</item>
        <item name="android:letterSpacing">-0.018</item>
        <item name="android:textColor">@color/bag_text_primary</item>
    </style>

    <style name="TextAppearance.Bag.TitleL" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineHeight">28sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">@color/bag_text_primary</item>
    </style>

    <style name="TextAppearance.Bag.TitleM" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:lineHeight">26sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/bag_text_primary</item>
    </style>

    <style name="TextAppearance.Bag.TitleS" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:letterSpacing">-0.006</item>
        <item name="android:textColor">@color/bag_text_primary</item>
    </style>

    <style name="TextAppearance.Bag.ButtonL" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Bag.BodyL" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/bag_text_primary</item>
    </style>

    <style name="TextAppearance.Bag.BodyLMedium" parent="TextAppearance.Bag.BodyL">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Bag.BodyM" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/bag_text_secondary</item>
    </style>

    <style name="TextAppearance.Bag.BodyMMedium" parent="TextAppearance.Bag.BodyM">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/bag_text_primary</item>
    </style>

    <style name="TextAppearance.Bag.LabelL" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineHeight">18sp</item>
        <item name="android:textColor">@color/bag_text_primary</item>
    </style>

    <style name="TextAppearance.Bag.LabelM" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineHeight">18sp</item>
        <item name="android:textColor">@color/bag_text_secondary</item>
    </style>

    <style name="TextAppearance.Bag.LabelS" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:textColor">@color/bag_text_tertiary_safe</item>
    </style>

    <style name="TextAppearance.Bag.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineHeight">14sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/bag_text_secondary</item>
    </style>

</resources>
