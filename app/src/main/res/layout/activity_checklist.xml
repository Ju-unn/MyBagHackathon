<?xml version="1.0" encoding="utf-8"?>
<!-- S11~S13 · 참여자 2명 이상 체크리스트: 공용 / 내 목록 / 분담 현황 3탭 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base">

    <LinearLayout
        android:id="@+id/checklistContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/checklistBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/topbar_back_button_margin_padded"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_cancel"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/checklist_title"
                android:textAppearance="@style/TextAppearance.Bag.DisplayM"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xs"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/checklistTripName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_md"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="@string/checklist_trip_name"
                android:textAppearance="@style/TextAppearance.Bag.BodyM" />

            <TextView
                android:id="@+id/checklistProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/checklist_progress_summary"
                android:textAppearance="@style/TextAppearance.Bag.BodyMMedium" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/checklistProgressBar"
            style="@style/Widget.Bag.ProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:max="100"
            android:progress="53" />

    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/checklistTabs"
        style="@style/Widget.Bag.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginEnd="@dimen/screen_margin"
        android:minHeight="@dimen/tab_bar_height">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checklist_tab_common" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checklist_tab_mine" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checklist_tab_assignment" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:id="@+id/checklistFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/checklistLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bag_loading_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/bag_brand_default" />
    </FrameLayout>

</FrameLayout>
