<?xml version="1.0" encoding="utf-8"?>
<!-- S10-12 체크리스트 — 타이틀 + 진행률 + 3탭 TabLayout, 탭 전환 시 프래그먼트를 직접 교체 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_margin">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checklist_title"
            android:textAppearance="@style/TextAppearance.Bag.DisplayM" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xs"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/checklistTripName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/checklist_trip_name"
                android:textAppearance="@style/TextAppearance.Bag.BodyM" />

            <TextView
                android:id="@+id/checklistProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/checklist_progress_summary"
                android:textAppearance="@style/TextAppearance.Bag.BodyMMedium" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/checklistProgressBar"
            style="@style/Widget.Bag.ProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:max="100"
            android:progress="53" />

    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/checklistTabs"
        style="@style/Widget.Bag.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_bar_height">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checklist_tab_common" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checklist_tab_mine" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checklist_tab_assignment" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:id="@+id/checklistFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
