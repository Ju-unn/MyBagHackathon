<?xml version="1.0" encoding="utf-8"?>
<!-- M13 · AssignmentRow — 담당자 = 미지정/나/다른사람, 확정상태 = 없음/체크됨/제외됨 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:background="@drawable/bg_input_field"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/assignmentRowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Bag.BodyL"
        tools:text="우산" />

    <com.example.mybaghackathon.ui.atoms.CheckboxView
        android:id="@+id/assignmentRowConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
