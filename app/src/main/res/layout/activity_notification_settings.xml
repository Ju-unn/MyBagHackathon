<?xml version="1.0" encoding="utf-8"?>
<!-- S15 알림 설정 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <include
        android:id="@+id/notifTopBar"
        layout="@layout/organism_top_app_bar_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_margin" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/notif_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notif_d7"
                android:textAppearance="@style/TextAppearance.Bag.BodyL"
                android:textSize="@dimen/notif_label_text_size" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/notifSwitchD7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/notif_switch_margin_end"
                android:alpha="0.4"
                android:enabled="false"
                android:scaleX="1.3"
                android:scaleY="1.3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/notif_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notif_d3"
                android:textAppearance="@style/TextAppearance.Bag.BodyL"
                android:textSize="@dimen/notif_label_text_size" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/notifSwitchD3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/notif_switch_margin_end"
                android:alpha="0.4"
                android:enabled="false"
                android:scaleX="1.3"
                android:scaleY="1.3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/notif_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notif_d1"
                android:textAppearance="@style/TextAppearance.Bag.BodyL"
                android:textSize="@dimen/notif_label_text_size" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/notifSwitchD1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/notif_switch_margin_end"
                android:alpha="0.4"
                android:enabled="false"
                android:scaleX="1.3"
                android:scaleY="1.3" />
        </LinearLayout>

        <!-- 정보 배너 (M8 WarningBanner를 info 색상으로 사용) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_restriction_info"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/bag_brand_default" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:padding="@dimen/space_lg"
                android:text="@string/notif_warning"
                android:textAppearance="@style/TextAppearance.Bag.BodyM"
                android:textColor="@color/bag_text_primary" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
