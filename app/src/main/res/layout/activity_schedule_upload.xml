<?xml version="1.0" encoding="utf-8"?>
<!-- S06 일정 사진 업로드 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- O1 TopAppBar (LargeTitle) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upload_title"
                android:textAppearance="@style/TextAppearance.Bag.DisplayM" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/upload_desc"
                android:textAppearance="@style/TextAppearance.Bag.BodyM" />

            <LinearLayout
                android:id="@+id/uploadScheduleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl">

                <include layout="@layout/molecule_upload_guide_card" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/uploadHotelCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <include layout="@layout/molecule_upload_guide_card" />
            </LinearLayout>

            <!-- M9 DashedAddCard — 사진 추가 안내 (56dp) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_dashed_card"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_add_more"
                    android:textAppearance="@style/TextAppearance.Bag.LabelM" />
            </FrameLayout>

            <!-- 국내/해외 세그먼트 컨트롤 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:background="@drawable/bg_segment_track"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/uploadSegmentDomestic"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/upload_segment_domestic"
                    android:textAppearance="@style/TextAppearance.Bag.BodyM"
                    android:textColor="@color/bag_text_tertiary_safe" />

                <TextView
                    android:id="@+id/uploadSegmentIntl"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_selected"
                    android:gravity="center"
                    android:text="@string/upload_segment_international"
                    android:textAppearance="@style/TextAppearance.Bag.TitleS" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/uploadBottomCta"
        layout="@layout/organism_bottom_cta" />

</LinearLayout>
