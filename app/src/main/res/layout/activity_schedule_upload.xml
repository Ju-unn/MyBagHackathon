<?xml version="1.0" encoding="utf-8"?>
<!-- S05 일정 사진 업로드 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/uploadTopAppBar"
                layout="@layout/organism_top_app_bar_large" />

            <!-- AddMore — 드롭존, 탭하면 사진 여러 장을 한 번에 선택 -->
            <FrameLayout
                android:id="@+id/uploadDropzone"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_dashed_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/image_plus"
                        app:tint="#3A7CA6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/upload_dropzone_title"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Bag.LabelL"
                        android:textColor="@color/bag_text_brand" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:text="@string/upload_dropzone_desc"
                        android:textAppearance="@style/TextAppearance.Bag.LabelM" />

                </LinearLayout>

            </FrameLayout>

            <!-- PreviewRow — 선택된 사진 썸네일 + 맨 끝 추가 타일(uploadAddTile) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/uploadPreviewRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/uploadBottomCta"
        layout="@layout/organism_bottom_cta" />

</LinearLayout>
