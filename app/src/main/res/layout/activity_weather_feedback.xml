<?xml version="1.0" encoding="utf-8"?>
<!-- S10 · 날씨·의식주 팁 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base">

    <LinearLayout
        android:id="@+id/feedbackContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_3xl">

            <include
                android:id="@+id/feedbackTopAppBar"
                layout="@layout/organism_top_app_bar_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_card_surface_border"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- TODO(배포전): feedback_region/temperature/period가 목업 더미값
                         (도쿄, 11°~14° 등). 코드가 실제 데이터로 덮어쓰지만 android:text
                         대신 tools:text로 바꾸는 게 더 안전함. -->
                    <TextView
                        android:id="@+id/feedbackRegion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_md"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/feedback_region"
                        android:textAppearance="@style/TextAppearance.Bag.TitleS"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/feedbackTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_temperature"
                        android:textAppearance="@style/TextAppearance.Bag.BodyLBold"
                        android:textColor="@color/bag_text_brand"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/feedbackPeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/feedback_period"
                    android:textAppearance="@style/TextAppearance.Bag.LabelM" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="top"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shirt"
                    app:tint="@color/bag_brand_default" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_clothing_title"
                        android:textAppearance="@style/TextAppearance.Bag.TitleS"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/feedbackClothingDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:text="@string/feedback_clothing_desc"
                        android:textAppearance="@style/TextAppearance.Bag.BodyM" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="top"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_utensils"
                    app:tint="@color/bag_brand_default" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_food_title"
                        android:textAppearance="@style/TextAppearance.Bag.TitleS"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/feedbackFoodDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:text="@string/feedback_food_desc"
                        android:textAppearance="@style/TextAppearance.Bag.BodyM" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="top"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_house"
                    app:tint="@color/bag_brand_default" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_stay_title"
                        android:textAppearance="@style/TextAppearance.Bag.TitleS"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/feedbackStayDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:text="@string/feedback_stay_desc"
                        android:textAppearance="@style/TextAppearance.Bag.BodyM" />
                </LinearLayout>
            </LinearLayout>

            <!-- 기능 연동 단계에서 서버 응답으로 교체할 동적 컨테이너 -->
            <LinearLayout
                android:id="@+id/feedbackSectionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 현재 Pen 최종안에는 하단 CTA가 없지만 기존 ViewBinding 호환을 위해 유지한다. -->
    <include
        android:id="@+id/feedbackBottomCta"
        layout="@layout/organism_bottom_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    </LinearLayout>

    <include
        android:id="@+id/feedbackState"
        layout="@layout/organism_screen_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
