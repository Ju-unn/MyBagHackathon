<?xml version="1.0" encoding="utf-8"?>
<!-- S08 반입 규정 안내 바텀시트 — 항목마다 카드 안에서 구분선으로 나뉜 행으로 표시됨 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_2xl"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_2xl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textStyle="bold"
        android:text="@string/review_restriction_dialog_title"
        android:textAppearance="@style/TextAppearance.Bag.TitleM" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl">

        <LinearLayout
            android:id="@+id/restrictionInfoList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_lg_border"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg" />

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/restrictionInfoConfirmButton"
        style="@style/Widget.Bag.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xl"
        android:text="@string/action_confirm" />

</LinearLayout>
