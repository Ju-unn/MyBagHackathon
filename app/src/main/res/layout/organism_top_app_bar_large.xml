<?xml version="1.0" encoding="utf-8"?>
<!-- O1 · TopAppBar (LargeTitle) — 제목 + 설명(선택) + 우측 액션 버튼(선택,
     IconButtonView), 스크롤 영역 상단에 사용. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 기본 숨김 — 뒤로가기가 필요한 화면(S05, S10 등)에서만 코드로 보이게 처리.
             Compact 상단바(O1 컴팩트)와 동일하게 버튼+제목을 한 줄에 배치해 통일감을 맞춤. -->
        <ImageButton
            android:id="@+id/topAppBarLargeBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/topbar_back_button_margin_padded"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:visibility="gone" />

        <TextView
            android:id="@+id/topAppBarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.Bag.DisplayM"
            tools:text="내 여행" />

        <com.example.mybaghackathon.ui.atoms.IconButtonView
            android:id="@+id/topAppBarAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/topAppBarDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.Bag.BodyM"
        android:visibility="gone"
        tools:text="분석된 내용을 확인하고 필요하면 수정하세요." />
</LinearLayout>
