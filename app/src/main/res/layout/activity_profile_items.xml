<?xml version="1.0" encoding="utf-8"?>
<!-- S15 내 기본 물품 전체보기 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <include
        android:id="@+id/profileItemsTopBar"
        layout="@layout/organism_top_app_bar_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_margin" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_2xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_items_swipe_hint"
                android:textAppearance="@style/TextAppearance.Bag.LabelM"
                android:textColor="@color/bag_text_secondary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/profileItemsRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:nestedScrollingEnabled="false"
                tools:itemCount="12"
                tools:listitem="@layout/molecule_default_item_row" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_2xl">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profileItemsAddButton"
            style="@style/Widget.Bag.Button.Secondary.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_add_item"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
