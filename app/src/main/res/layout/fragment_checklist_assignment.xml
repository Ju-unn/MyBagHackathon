<?xml version="1.0" encoding="utf-8"?>
<!-- S13 · 체크리스트 분담 현황 탭 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_4xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 참여 인원 요약 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/checklistAssignmentAvatarStack"
                layout="@layout/molecule_avatar_stack" />

            <!-- TODO(배포전): checklist_assignment_summary가 목업 더미값("2명이 함께
                 준비 중"). 코드가 덮어쓰지만 android:text 대신 tools:text로 바꾸는 게
                 더 안전함. -->
            <TextView
                android:id="@+id/checklistAssignmentSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/checklist_assignment_summary"
                android:textAppearance="@style/TextAppearance.Bag.BodyMMedium" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/checklistAssignmentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="@string/checklist_unassigned"
            android:textAppearance="@style/TextAppearance.Bag.TitleS"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/checklistUnassignedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="@string/checklist_assignment_hint"
            android:textAppearance="@style/TextAppearance.Bag.Caption" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
