<?xml version="1.0" encoding="utf-8"?>
<!-- S13 · 체크리스트 분담 현황 탭 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_4xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 참여 인원 요약: 담당 항목이 하나라도 배정된 사람이 없으면 클래스에서 GONE 처리 -->
        <LinearLayout
            android:id="@+id/checklistAssignmentSummaryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/checklistAssignmentAvatarStack"
                layout="@layout/molecule_avatar_stack" />

            <TextView
                android:id="@+id/checklistAssignmentSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                tools:text="@string/checklist_assignment_summary"
                android:textAppearance="@style/TextAppearance.Bag.BodyMMedium" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/checklistAssignmentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/checklistAssignmentUnassignedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/checklistUnassignedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/checklist_unassigned"
                android:textAppearance="@style/TextAppearance.Bag.TitleS"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/checklistUnassignedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical" />
        </LinearLayout>

        <include
            android:id="@+id/checklistAssignmentEmptyState"
            layout="@layout/organism_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/empty_state_top_margin"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
