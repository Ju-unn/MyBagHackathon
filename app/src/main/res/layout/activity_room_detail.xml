<?xml version="1.0" encoding="utf-8"?>
<!-- S09 · 방 상세 & 팁 허브 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_2xl">

            <include
                android:id="@+id/roomDetailTopBar"
                layout="@layout/organism_top_app_bar_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/room_detail_schedule_title"
                android:textAppearance="@style/TextAppearance.Bag.DisplayM"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_card_surface_border"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_regular"
                    android:text="@string/room_detail_destination_label"
                    android:textAppearance="@style/TextAppearance.Bag.LabelS"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/room_detail_destination_value"
                    android:textAppearance="@style/TextAppearance.Bag.TitleM"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card_surface_border"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_regular"
                    android:text="@string/room_detail_dates_label"
                    android:textAppearance="@style/TextAppearance.Bag.LabelS"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/room_detail_dates_value"
                    android:textAppearance="@style/TextAppearance.Bag.TitleS"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card_surface_border"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/room_detail_weather_title"
                    android:textAppearance="@style/TextAppearance.Bag.TitleS"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/room_detail_weather_day1"
                        android:textAppearance="@style/TextAppearance.Bag.BodyMMedium" />

                    <com.example.mybaghackathon.ui.atoms.WeatherIconView
                        android:layout_width="20dp"
                        android:layout_height="20dp" />

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical|end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/room_detail_weather_status1"
                        android:textAppearance="@style/TextAppearance.Bag.BodyM" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/room_detail_weather_day2"
                        android:textAppearance="@style/TextAppearance.Bag.BodyMMedium" />

                    <com.example.mybaghackathon.ui.atoms.WeatherIconView
                        android:layout_width="20dp"
                        android:layout_height="20dp" />

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical|end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/room_detail_weather_status2"
                        android:textAppearance="@style/TextAppearance.Bag.BodyM" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/room_detail_weather_day3"
                        android:textAppearance="@style/TextAppearance.Bag.BodyMMedium" />

                    <com.example.mybaghackathon.ui.atoms.WeatherIconView
                        android:layout_width="20dp"
                        android:layout_height="20dp" />

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical|end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/room_detail_weather_status3"
                        android:textAppearance="@style/TextAppearance.Bag.BodyM" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/roomDetailRestrictionWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_restriction_danger"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/bag_status_danger" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="@dimen/space_lg"
                    android:text="@string/room_detail_restriction_warning"
                    android:textAppearance="@style/TextAppearance.Bag.BodyM"
                    android:textColor="@color/bag_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/room_detail_members"
                        android:textAppearance="@style/TextAppearance.Bag.TitleS"
                        android:textStyle="bold" />

                    <!-- 방장 전용 영역: 일반 참여자 화면에서는 클래스에서 GONE 처리 -->
                    <LinearLayout
                        android:id="@+id/roomDetailHostInviteArea"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/roomDetailInviteButton"
                            style="@style/Widget.Bag.Button.Primary"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_gravity="end"
                            android:contentDescription="@string/room_detail_invite_button"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="12dp"
                            android:textColor="@color/bag_text_on_brand"
                            app:cornerRadius="@dimen/radius_full"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="24dp"
                            app:iconTint="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2xs"
                            android:text="@string/room_detail_invite_note"
                            android:textAppearance="@style/TextAppearance.Bag.Caption" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/roomDetailMemberList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/roomDetailBottomCta"
        layout="@layout/organism_room_detail_bottom_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
