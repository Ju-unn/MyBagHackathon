<?xml version="1.0" encoding="utf-8"?>
<!-- S10 체크리스트 · 공용 리스트 탭 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 우선순위 필터 칩 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <com.example.mybaghackathon.ui.atoms.ChipView
                android:id="@+id/checklistFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                app:chipActive="true"
                app:chipLabel="@string/checklist_filter_all" />

            <com.example.mybaghackathon.ui.atoms.ChipView
                android:id="@+id/checklistFilterEssential"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                app:chipActive="false"
                app:chipLabel="@string/checklist_filter_essential" />

            <com.example.mybaghackathon.ui.atoms.ChipView
                android:id="@+id/checklistFilterMid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                app:chipActive="false"
                app:chipLabel="@string/checklist_filter_mid" />

            <com.example.mybaghackathon.ui.atoms.ChipView
                android:id="@+id/checklistFilterOptional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipActive="false"
                app:chipLabel="@string/checklist_filter_optional" />

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/checklistClaimNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/checklist_claim_note_member"
            android:textAppearance="@style/TextAppearance.Bag.Caption" />

        <LinearLayout
            android:id="@+id/checklistCommonSections"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:visibility="gone" />

        <include
            android:id="@+id/checklistCommonPreviewSections"
            layout="@layout/preview_checklist_common_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone"
            tools:visibility="visible" />

        <include
            android:id="@+id/checklistCommonEmptyState"
            layout="@layout/organism_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/checklistCommonAddWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_lg">

        <include layout="@layout/molecule_checklist_add_card" />
    </FrameLayout>
</LinearLayout>
