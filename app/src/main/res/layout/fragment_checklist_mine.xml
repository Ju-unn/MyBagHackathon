<?xml version="1.0" encoding="utf-8"?>
<!-- S12 · 체크리스트 내 목록 탭 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <com.example.mybaghackathon.ui.atoms.ChipView
                android:id="@+id/checklistMineFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                app:chipActive="true"
                app:chipLabel="@string/checklist_filter_all" />

            <com.example.mybaghackathon.ui.atoms.ChipView
                android:id="@+id/checklistMineFilterEssential"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                app:chipActive="false"
                app:chipLabel="@string/checklist_filter_essential" />

            <com.example.mybaghackathon.ui.atoms.ChipView
                android:id="@+id/checklistMineFilterMid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                app:chipActive="false"
                app:chipLabel="@string/checklist_filter_mid" />

            <com.example.mybaghackathon.ui.atoms.ChipView
                android:id="@+id/checklistMineFilterOptional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipActive="false"
                app:chipLabel="@string/checklist_filter_optional" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/checklistMineList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            tools:visibility="gone" />

        <include
            android:id="@+id/checklistMinePreviewItems"
            layout="@layout/preview_checklist_mine_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/checklist_swipe_hint"
            android:textAppearance="@style/TextAppearance.Bag.Caption" />

        <FrameLayout
            android:id="@+id/checklistMineEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <include layout="@layout/organism_empty_state" />
        </FrameLayout>

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/checklistMineAddWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_lg">

        <include layout="@layout/molecule_checklist_add_card" />
    </FrameLayout>
</LinearLayout>
