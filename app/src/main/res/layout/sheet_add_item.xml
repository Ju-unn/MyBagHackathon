<?xml version="1.0" encoding="utf-8"?>
<!-- BS02 항목 직접 추가 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_2xl"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_2xl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:gravity="center"
        android:text="@string/bs_add_item_title"
        android:textAppearance="@style/TextAppearance.Bag.TitleM" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/addItemNameLayout"
        style="@style/Widget.Bag.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:hint="@string/bs_add_item_name_label">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/addItemNameInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/text_field_height"
            android:textAppearance="@style/TextAppearance.Bag.BodyL" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:textStyle="bold"
        android:text="@string/bs_add_item_priority_label"
        android:textAppearance="@style/TextAppearance.Bag.LabelL" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:orientation="horizontal">

        <com.example.mybaghackathon.ui.atoms.ChipView
            android:id="@+id/addItemPriorityHigh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            app:chipActive="true"
            app:chipLabel="@string/review_priority_high" />

        <com.example.mybaghackathon.ui.atoms.ChipView
            android:id="@+id/addItemPriorityMid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            app:chipActive="false"
            app:chipLabel="@string/review_priority_mid" />

        <com.example.mybaghackathon.ui.atoms.ChipView
            android:id="@+id/addItemPriorityLow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipActive="false"
            app:chipLabel="@string/review_priority_low" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addItemSaveButton"
        style="@style/Widget.Bag.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xl"
        android:text="@string/action_add" />

</LinearLayout>
