<?xml version="1.0" encoding="utf-8"?>
<!-- S08 일정 검토 — 세로로 긴 스크롤 화면 (NestedScrollView) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_2xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/reviewTopAppBar"
                layout="@layout/organism_top_app_bar_large" />

            <!-- Step1Badge -->
            <TextView
                android:id="@+id/reviewStep1Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:background="@drawable/bg_pill_brand_subtle"
                android:fontFamily="@font/pretendard_bold"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/review_step1_label"
                android:textColor="@color/bag_text_brand"
                android:textSize="11sp" />

            <!-- ScheduleInfo — 여행지/숙소일정 카드 2개, 가로로 나란히 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/reviewDestinationCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <include layout="@layout/molecule_review_field_card" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/reviewDatesCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md">

                    <include layout="@layout/molecule_review_field_card" />
                </FrameLayout>

            </LinearLayout>

            <!-- WeatherCard -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:background="@drawable/bg_card_lg_border"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/review_weather_heading"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextAppearance.Bag.TitleS" />

                <LinearLayout
                    android:id="@+id/reviewWeatherList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/review_weather_disclaimer"
                    android:textAppearance="@style/TextAppearance.Bag.Caption"
                    android:textColor="@color/bag_text_tertiary_safe" />

            </LinearLayout>

            <!-- Step2Badge -->
            <TextView
                android:id="@+id/reviewStep2Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:background="@drawable/bg_pill_brand_subtle"
                android:fontFamily="@font/pretendard_bold"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/review_step2_label"
                android:textColor="@color/bag_text_brand"
                android:textSize="11sp" />

            <!-- M8 WarningBanner — 반입 제한 경고, 제한 항목 있을 때만 노출 -->
            <FrameLayout
                android:id="@+id/reviewRestrictionWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl">

                <include layout="@layout/molecule_warning_banner" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/review_restriction_disclaimer"
                android:textAppearance="@style/TextAppearance.Bag.Caption"
                android:textColor="@color/bag_text_tertiary_safe" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:textStyle="bold"
                android:text="@string/review_items_heading"
                android:textAppearance="@style/TextAppearance.Bag.TitleL" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/review_items_desc"
                android:textAppearance="@style/TextAppearance.Bag.BodyM" />

            <LinearLayout
                android:id="@+id/reviewItemSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/reviewBottomCta"
        layout="@layout/organism_bottom_cta" />

</LinearLayout>
