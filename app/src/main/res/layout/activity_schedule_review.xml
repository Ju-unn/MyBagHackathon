<?xml version="1.0" encoding="utf-8"?>
<!-- S08 일정 검토 — 세로로 긴 스크롤 화면 (NestedScrollView) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <include
        android:id="@+id/reviewTopBar"
        layout="@layout/organism_top_app_bar_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_margin" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_2xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/review_desc"
                android:textAppearance="@style/TextAppearance.Bag.BodyM" />

            <FrameLayout
                android:id="@+id/reviewDestinationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <include layout="@layout/molecule_review_field_card" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/reviewDatesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <include layout="@layout/molecule_review_field_card" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/review_weather_heading"
                android:textAppearance="@style/TextAppearance.Bag.TitleS" />

            <LinearLayout
                android:id="@+id/reviewWeatherList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical"
                android:background="@drawable/bg_card_surface_border"
                android:padding="@dimen/space_lg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/review_items_heading"
                android:textAppearance="@style/TextAppearance.Bag.TitleS" />

            <LinearLayout
                android:id="@+id/reviewItemSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/reviewAddItemLink"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:gravity="center_vertical"
                android:text="@string/review_add_item"
                android:textAppearance="@style/TextAppearance.Bag.BodyLMedium"
                android:textColor="@color/bag_text_brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/review_excluded_heading"
                android:textAppearance="@style/TextAppearance.Bag.TitleS" />

            <LinearLayout
                android:id="@+id/reviewExcludedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/reviewBottomCta"
        layout="@layout/organism_bottom_cta" />

</LinearLayout>
