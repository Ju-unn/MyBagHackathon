<?xml version="1.0" encoding="utf-8"?>
<!-- S06 분석 중 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin">

    <!-- 상단 스페이서 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 중앙 블록: 스피너 + 진행 문구 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/bag_brand_default" />

        <!-- 한 번에 한 줄만 보여주고 페이드 아웃/인으로 다음 단계로 전환 (AnalyzingActivity에서 애니메이션) -->
        <TextView
            android:id="@+id/analyzingStepText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Bag.BodyLMedium"
            android:textColor="@color/bag_text_primary" />

    </LinearLayout>

    <!-- 하단 스페이서 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 취소 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="@dimen/space_2xl">

        <TextView
            android:id="@+id/analyzingCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="취소"
            android:textAppearance="@style/TextAppearance.Bag.BodyLMedium"
            android:textColor="@color/bag_text_secondary" />

    </LinearLayout>

</LinearLayout>
