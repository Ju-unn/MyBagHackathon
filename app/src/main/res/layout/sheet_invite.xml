<?xml version="1.0" encoding="utf-8"?>
<!-- BS01 초대 링크 공유 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_2xl"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_2xl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textStyle="bold"
        android:text="@string/bs_invite_title"
        android:textAppearance="@style/TextAppearance.Bag.TitleM" />

    <TextView
        android:id="@+id/inviteLinkText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:background="@drawable/bg_input_field"
        android:ellipsize="middle"
        android:padding="@dimen/space_lg"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Bag.BodyM"
        tools:text="https://mybag.duckdns.org/invite/8f2c91" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/inviteCopyLinkButton"
            style="@style/Widget.Bag.Button.Secondary.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:text="@string/action_copy_link" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/inviteKakaoButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/kakao_yellow"
            android:text="@string/action_share_kakao"
            android:textColor="@color/kakao_text"
            app:cornerRadius="@dimen/radius_md"
            app:elevation="0dp"
            app:icon="@drawable/ic_message_circle"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/kakao_text" />
    </LinearLayout>

</LinearLayout>
