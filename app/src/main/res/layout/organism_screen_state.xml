<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">

    <ProgressBar
        android:id="@+id/screenStateProgress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/bag_brand_default" />

    <TextView
        android:id="@+id/screenStateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Bag.TitleS"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/screenStateMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Bag.BodyM" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/screenStateRetry"
        style="@style/Widget.Bag.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/action_retry"
        android:visibility="gone" />
</LinearLayout>
