<?xml version="1.0" encoding="utf-8"?>
<!-- O5 · BottomCTA — 버튼 = 1개/2개. 상단 1dp 구분선은 화면 콘텐츠가
     스크롤됐을 때만 보임 (스크롤 리스너에서 코드로 토글:
     view.findViewById(R.id.bottomCtaDivider).setVisibility(...)). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <View
        android:id="@+id/bottomCtaDivider"
        style="@style/Widget.Bag.Divider"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/bottomCtaButtonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottomCtaPrimary"
            style="@style/Widget.Bag.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_add" />
    </LinearLayout>
</LinearLayout>
