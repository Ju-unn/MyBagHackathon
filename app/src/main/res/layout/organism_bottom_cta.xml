<?xml version="1.0" encoding="utf-8"?>
<!-- O5 · BottomCTA — Buttons = 1/2. Top 1dp divider only shows once the
     screen content is scrolled (toggle programmatically via a scroll
     listener: view.findViewById(R.id.bottomCtaDivider).setVisibility(...)). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <View
        android:id="@+id/bottomCtaDivider"
        style="@style/Widget.Bag.Divider"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/bottomCtaButtonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottomCtaPrimary"
            style="@style/Widget.Bag.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_add" />
    </LinearLayout>
</LinearLayout>
