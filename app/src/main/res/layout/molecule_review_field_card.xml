<?xml version="1.0" encoding="utf-8"?>
<!-- M11 · ReviewFieldCard — 수정 가능 여부 = True/False -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_lg_border"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reviewFieldLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Bag.LabelS"
            tools:text="여행지" />

        <TextView
            android:id="@+id/reviewFieldEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_edit"
            android:textAppearance="@style/TextAppearance.Bag.BodyMMedium"
            android:textColor="@color/bag_text_brand" />
    </LinearLayout>

    <TextView
        android:id="@+id/reviewFieldValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Bag.TitleM"
        tools:text="도쿄, 일본" />
</LinearLayout>
