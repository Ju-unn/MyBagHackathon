<?xml version="1.0" encoding="utf-8"?>
<!-- S13 공용 여행 — TopAppBar(Large) + 세그먼트 컨트롤 + 여행 목록 + 방 만들기 FAB -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_4xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/archiveTopAppBar"
            layout="@layout/organism_top_app_bar_large" />

        <LinearLayout
            android:id="@+id/archiveSegmentRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/archiveSegmentActive"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_selected"
                android:gravity="center"
                android:text="@string/archive_segment_active"
                android:textAppearance="@style/TextAppearance.Bag.TitleS" />

            <TextView
                android:id="@+id/archiveSegmentPast"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/archive_segment_past"
                android:textAppearance="@style/TextAppearance.Bag.BodyM"
                android:textColor="@color/bag_text_tertiary_safe" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/archiveTripRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <include
            android:id="@+id/archiveEmptyState"
            layout="@layout/organism_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/empty_state_top_margin"
            android:visibility="gone" />

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/archiveAddRoomFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_xl"
        android:contentDescription="@string/home_add_room"
        android:src="@drawable/ic_add"
        android:visibility="gone"
        app:backgroundTint="@color/bag_brand_default"
        app:tint="@color/white_primitive" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
