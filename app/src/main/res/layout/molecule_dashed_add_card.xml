<?xml version="1.0" encoding="utf-8"?>
<!-- M9 · DashedAddCard — Size = L / S. Dashed drawables need a software
     layer to render (set in code: view.setLayerType(LAYER_TYPE_SOFTWARE, null)). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashedAddCardRoot"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/bg_dashed_card"
    android:gravity="center">

    <TextView
        android:id="@+id/dashedAddCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/home_add_room"
        android:textAppearance="@style/TextAppearance.Bag.TitleS"
        android:textColor="@color/bag_text_brand"
        tools:text="+ 방 만들기" />
</FrameLayout>
