<?xml version="1.0" encoding="utf-8"?>
<!-- S03 홈 — TopAppBar(Large) + TripRoomCard 목록 + DashedAddCard -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:clipToPadding="false"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_4xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/homeTopAppBar"
            layout="@layout/organism_top_app_bar_large" />

        <LinearLayout
            android:id="@+id/homeTripList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical"
            android:showDividers="middle"
            android:divider="@null" />

        <FrameLayout
            android:id="@+id/homeAddRoomWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">

            <include layout="@layout/molecule_dashed_add_card" />
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
