<?xml version="1.0" encoding="utf-8"?>
<!-- S15 프로필 — 아바타/이름 카드 + 내 기본 물품 미리보기 + 설정 목록 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:clipToPadding="false"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_4xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/profileTopAppBar"
            layout="@layout/organism_top_app_bar_large" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_card_surface_border"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_lg">

            <com.example.mybaghackathon.ui.atoms.AvatarView
                android:id="@+id/profileAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp" />

            <TextView
                android:id="@+id/profileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Bag.TitleL"
                tools:text="김민지" />

        </LinearLayout>

        <View
            style="@style/Widget.Bag.Divider"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@color/bag_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_my_items"
                android:textAppearance="@style/TextAppearance.Bag.TitleS"
                android:textSize="@dimen/profile_section_header_text_size" />

            <TextView
                android:id="@+id/profileItemCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Bag.LabelM"
                android:textColor="@color/bag_text_secondary"
                android:textSize="@dimen/profile_section_header_text_size"
                tools:text="12개" />

        </LinearLayout>

        <View style="@style/Widget.Bag.Divider" android:layout_marginTop="@dimen/space_lg" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profileItemRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:nestedScrollingEnabled="false"
            tools:itemCount="4"
            tools:listitem="@layout/molecule_default_item_row" />

        <LinearLayout
            android:id="@+id/profileViewAllRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_list_row_ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_view_all"
                android:textAppearance="@style/TextAppearance.Bag.BodyLMedium"
                android:textColor="@color/bag_text_brand" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right" />

        </LinearLayout>

        <View
            style="@style/Widget.Bag.Divider"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@color/bag_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/profile_settings"
            android:textAppearance="@style/TextAppearance.Bag.TitleS"
            android:textSize="@dimen/profile_section_header_text_size" />

        <LinearLayout
            android:id="@+id/profileNotifRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_list_row_ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="@dimen/space_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_bell" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_notification_settings"
                android:textAppearance="@style/TextAppearance.Bag.BodyL" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileLogoutRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_list_row_ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="@dimen/space_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_logout" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_logout"
                android:textAppearance="@style/TextAppearance.Bag.BodyL"
                android:textColor="@color/bag_status_danger" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileWithdrawRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_list_row_ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="@dimen/space_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_trash"
                app:tint="@color/bag_status_danger" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_withdraw"
                android:textAppearance="@style/TextAppearance.Bag.BodyL"
                android:textColor="@color/bag_status_danger" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileVersionRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="@dimen/space_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_info" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_version"
                android:textAppearance="@style/TextAppearance.Bag.BodyL" />

            <TextView
                android:text="@string/profile_version_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Bag.LabelM"
                android:textColor="@color/bag_text_secondary" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
