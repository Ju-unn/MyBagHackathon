<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/restrictionRowName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.Bag.BodyL"
            tools:text="보조배터리" />

        <TextView
            android:id="@+id/restrictionRowType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.Bag.LabelM"
            tools:text="기내만 가능" />
    </LinearLayout>

    <TextView
        android:id="@+id/restrictionRowReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xs"
        android:textAppearance="@style/TextAppearance.Bag.BodyM"
        android:textColor="@color/bag_text_tertiary_safe"
        tools:text="리튬이온 보조배터리는 위탁수하물 반입이 제한됩니다" />

</LinearLayout>
