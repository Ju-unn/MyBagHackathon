<?xml version="1.0" encoding="utf-8"?>
<!-- S04 방 만들기 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <include
        android:id="@+id/createRoomTopBar"
        layout="@layout/organism_top_app_bar_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_margin" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/createRoomNameField"
                layout="@layout/molecule_text_field" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/create_room_invite_label"
                android:textAppearance="@style/TextAppearance.Bag.TitleS" />

            <LinearLayout
                android:id="@+id/createRoomMemberList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/createRoomBottomCta"
        layout="@layout/organism_bottom_cta" />

</LinearLayout>
