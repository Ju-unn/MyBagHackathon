<?xml version="1.0" encoding="utf-8"?>
<!-- S04 방 만들기 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <include
        android:id="@+id/createRoomTopBar"
        layout="@layout/organism_top_app_bar_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/topbar_back_button_margin"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginEnd="@dimen/screen_margin" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_room_name_label"
                android:textAppearance="@style/TextAppearance.Bag.LabelM" />

            <include
                android:id="@+id/createRoomNameField"
                layout="@layout/molecule_text_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" />

            <!-- 방 이름이 20자를 넘으면만 노출 -->
            <TextView
                android:id="@+id/createRoomNameLengthNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/create_room_name_length_notice"
                android:textAppearance="@style/TextAppearance.Bag.Caption"
                android:textColor="@color/bag_status_warning"
                android:visibility="gone" />

            <!-- 초대 인원 스테퍼 (펜슬 StepperField) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/create_room_invite_label"
                    android:textAppearance="@style/TextAppearance.Bag.LabelM" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/text_field_height"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_sm">

                    <FrameLayout
                        android:id="@+id/createRoomMemberMinus"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:background="@drawable/oval_subtle">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_remove"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/createRoomMemberCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="1명"
                        android:textAppearance="@style/TextAppearance.Bag.TitleS" />

                    <FrameLayout
                        android:id="@+id/createRoomMemberPlus"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:background="@drawable/oval_solid">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_add"
                            android:contentDescription="@null" />
                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/createRoomBottomCta"
        layout="@layout/organism_bottom_cta" />

</LinearLayout>
