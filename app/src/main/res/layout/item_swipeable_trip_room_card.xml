<?xml version="1.0" encoding="utf-8"?>
<!-- S03/S14 여행방 리스트 행. organism_trip_room_card를 왼쪽으로 스와이프하면
     뒤에 깔린 액션 버튼(tripSwipeDeleteButton)이 드러남 — 방장이면 삭제, 참여자면 나가기. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/tripSwipeDeleteButton"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 스와이프로 드러나는 영역(trip_delete_reveal_width) 안에서 동그란 버튼만
             가운데 정렬 — 뒤 배경은 색을 채우지 않고, 이 원 안에만 색을 채운다. -->
        <LinearLayout
            android:layout_width="@dimen/trip_delete_button_size"
            android:layout_height="@dimen/trip_delete_button_size"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/space_lg"
            android:background="@drawable/bg_circle_swipe_delete"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tripSwipeActionIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_trash"
                android:contentDescription="@string/action_delete" />

            <TextView
                android:id="@+id/tripSwipeActionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/action_delete"
                android:textAppearance="@style/TextAppearance.Bag.LabelS"
                android:textColor="@color/white_primitive" />
        </LinearLayout>
    </FrameLayout>

    <!-- 그림자와 카드를 한 덩어리로 묶어서 스와이프 시(translationX) 같이 움직이게 함
         — 그림자를 카드 밖 형제뷰로 따로 두면 카드만 밀려나면서 그림자가 스와이프
         액션 영역처럼 보이는 문제가 있었음.
         그림자는 이 wrapper 자체의 배경으로 깔고, 카드를 오른쪽/아래로 card_shadow_offset만큼
         안쪽으로 밀어 넣어서 그 여백으로 배경(그림자)이 살짝 드러나게 한다 — 별도 뷰를
         match_parent 높이로 두면 wrap_content 부모 안에서 높이가 0으로 측정되는 경우가 있어
         이 방식이 더 안정적이다. -->
    <FrameLayout
        android:id="@+id/tripSwipeForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_offset_shadow">

        <include
            layout="@layout/organism_trip_room_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/card_shadow_offset"
            android:layout_marginBottom="@dimen/card_shadow_offset" />
    </FrameLayout>

</FrameLayout>
