<?xml version="1.0" encoding="utf-8"?>
<!-- S02 로그인 — 펜슬 디자인 기준: 상단은 화면 끝까지 꽉 채운 브랜드 비주얼 블록,
     하단은 카피 + 카카오 CTA + 약관 문구를 담은 콘텐츠 블록 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bag_bg_base"
    android:orientation="vertical">

    <!-- 브랜드 비주얼: 화면 폭 꽉 채움, 배경은 브랜드 연한색, 중앙에 앱 아이콘 아트워크.
         고정 높이 대신 남는 세로 공간을 채우는 weight로 잡아서, 화면이 작은
         기기에서는 잘리지 않게 줄어들고 화면이 큰 기기에서는 아이콘 주변
         여백으로 자연스럽게 늘어나 반응형으로 동작함 -->
    <FrameLayout
        android:id="@+id/loginArtwork"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_login_artwork">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="152dp"
            android:layout_height="152dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/img_app_icon"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Bag.RoundedIcon" />

    </FrameLayout>

    <!-- 콘텐츠 블록 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <TextView
            android:id="@+id/loginCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_copy"
            android:textAppearance="@style/TextAppearance.Bag.DisplayL"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loginSubcopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/login_subcopy"
            android:textAppearance="@style/TextAppearance.Bag.BodyM" />

        <!-- 카카오 로그인 디자인 가이드 준수: PSD 원본에서 심볼 벡터 패스와
             레이블 문구를 분리 추출해 심볼(ic_kakao_symbol) + 텍스트 조합으로
             재구성함. 완성 이미지(90px 고정 높이)를 그대로 쓰면 버튼이 과도하게
             커지는 문제가 있어, 높이를 자유롭게 조절할 수 있도록 분리함.
             가이드가 정한 색상(컨테이너 #FEE500 / 심볼 #000000 / 레이블
             #000000 85%)과 형태·비율은 그대로 유지.
             https://developers.kakao.com/docs/ko/kakaologin/design-guide -->
        <FrameLayout
            android:id="@+id/loginKakaoButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_kakao_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/space_lg"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_kakao_symbol" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/action_kakao_login"
                android:textAppearance="@style/TextAppearance.Bag.ButtonL"
                android:textColor="@color/kakao_text" />

        </FrameLayout>

        <TextView
            android:id="@+id/loginTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:text="@string/login_terms"
            android:textColor="@color/bag_text_tertiary_safe"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
