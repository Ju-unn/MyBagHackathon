<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/loginArtwork"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_login_artwork">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="152dp"
            android:layout_height="152dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/img_app_icon"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Bag.RoundedIcon" />

    </FrameLayout>

    <!-- 콘텐츠 블록 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <TextView
            android:id="@+id/loginCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_copy"
            android:textAppearance="@style/TextAppearance.Bag.DisplayL"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loginSubcopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/login_subcopy"
            android:textAppearance="@style/TextAppearance.Bag.BodyM" />

        <!-- 카카오 로그인 디자인 가이드 준수: PSD 원본에서 심볼 벡터 패스와
             레이블 문구를 분리 추출해 심볼(ic_kakao_symbol) + 텍스트 조합으로
             재구성함. 완성 이미지(90px 고정 높이)를 그대로 쓰면 버튼이 과도하게
             커지는 문제가 있어, 높이를 자유롭게 조절할 수 있도록 분리함.
             가이드가 정한 색상(컨테이너 #FEE500 / 심볼 #000000 / 레이블
             #000000 85%)과 형태·비율은 그대로 유지.
             https://developers.kakao.com/docs/ko/kakaologin/design-guide -->
        <FrameLayout
            android:id="@+id/loginKakaoButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_kakao_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/space_lg"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_kakao_symbol" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/action_kakao_login"
                android:textAppearance="@style/TextAppearance.Bag.ButtonL"
                android:textColor="@color/kakao_text" />

        </FrameLayout>

        <!-- 필수 동의 — 둘 다 체크해야 카카오 버튼 활성화(LoginActivity에서 게이팅) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/agreePrivacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/login_agree_privacy"
                android:textColor="@color/bag_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/viewPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_xs"
                android:text="@string/login_agree_view"
                android:textColor="@color/bag_text_tertiary_safe"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/agreeTerms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/login_agree_terms"
                android:textColor="@color/bag_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/viewTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_xs"
                android:text="@string/login_agree_view"
                android:textColor="@color/bag_text_tertiary_safe"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
