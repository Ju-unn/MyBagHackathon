<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 간격 스케일 (10종) — BagSpacing.xxx -->
    <dimen name="space_2xs">4dp</dimen>
    <dimen name="space_xs">6dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">20dp</dimen>
    <dimen name="space_2xl">24dp</dimen>
    <dimen name="space_3xl">32dp</dimen>
    <dimen name="space_4xl">40dp</dimen>
    <dimen name="space_5xl">56dp</dimen>

    <!-- 모서리 반경 스케일 (6종) — BagRadius.xxx -->
    <dimen name="radius_xs">6dp</dimen>
    <dimen name="radius_sm">12dp</dimen>
    <dimen name="radius_md">16dp</dimen>
    <dimen name="radius_lg">18dp</dimen>
    <dimen name="radius_xl">22dp</dimen>
    <dimen name="radius_full">999dp</dimen>

    <!-- img_app_icon.png 원본의 둥근 사각형 곡률 + 흰 여백을 그대로 이어가도록
         역산한 값(원본 1254px 기준 반경≈275px, 여백≈34px → (275+34)/1254 비율) -->
    <dimen name="radius_app_icon">37dp</dimen>

    <!-- 최소 터치 영역 (QA 체크리스트 §5) -->
    <dimen name="touch_target_min">48dp</dimen>

    <!-- 화면 콘텐츠 좌우 여백 — values-sw*/dimens.xml에서 화면 폭별로 재정의됨 -->
    <dimen name="screen_margin">20dp</dimen>

    <!-- 자주 쓰는 컴포넌트 크기 -->
    <dimen name="avatar_size_sm">24dp</dimen>
    <dimen name="avatar_size_md">26dp</dimen>
    <dimen name="avatar_size_lg">28dp</dimen>
    <dimen name="avatar_size_xl">36dp</dimen>
    <dimen name="icon_button_size">36dp</dimen>
    <dimen name="checkbox_size">22dp</dimen>
    <dimen name="button_height">64dp</dimen>
    <dimen name="button_height_secondary">58dp</dimen>
    <dimen name="text_field_height">64dp</dimen>
    <dimen name="bottom_nav_height">64dp</dimen>
    <dimen name="tab_bar_height">48dp</dimen>

    <!-- 여행방 카드(TripRoomCard) 최소 높이 — 상태별(진행중/예정/지난) 콘텐츠 양이
         달라 wrap_content만으로는 카드 크기가 들쭉날쭉하고 작아 보이는 문제 보완 -->
    <dimen name="trip_card_min_height">128dp</dimen>

    <!-- 여행방 카드 안 텍스트 크기 — 기존 텍스트가 작고 두께감이 없다는
         피드백으로 상태 라벨/제목/보조 텍스트를 한 단계씩 키움 -->
    <dimen name="trip_card_status_text_size">14sp</dimen>
    <dimen name="trip_card_title_text_size">23sp</dimen>
    <dimen name="trip_card_body_text_size">15sp</dimen>

    <!-- 여행방 카드 상태 라벨(진행중/준비 전/완료)을 D-day 배지처럼 알약형으로
         감싸는 배경의 높이 -->
    <dimen name="trip_card_status_pill_height">26dp</dimen>

    <!-- 알림 설정 스위치 행 높이 — 스위치를 확대(scale)해도 여유 공간 확보 -->
    <dimen name="notif_row_height">56dp</dimen>

    <!-- 알림 설정 라벨("D-7 알림" 등) 텍스트 크기 -->
    <dimen name="notif_label_text_size">17sp</dimen>
    <!-- 스위치를 scaleX/Y로 확대하면 화면 끝 쪽으로 넘치므로, 그만큼 왼쪽으로
         당겨오기 위한 여백 -->
    <dimen name="notif_switch_margin_end">14dp</dimen>

    <!-- 프로필 섹션 헤더("내 기본 물품", 개수, "설정") 텍스트 — 아래 하위
         텍스트(TextAppearance.Bag.BodyL, 15sp)의 1.5배 크기 -->
    <dimen name="profile_section_header_text_size">22.5sp</dimen>
</resources>
