<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 앱 기본 테마. 의도적으로 라이트 모드 전용으로 설계함 (README §1 참고:
         Starter 플랜의 변수 컬렉션은 모드를 하나만 지원함; 다크 모드는
         의도적으로 범위 밖으로 뺌). values-night/themes.xml도 이 테마와
         동일하게 맞춰서, 디자인되지 않은 다크 팔레트로 앱이 바뀌지 않도록 함. -->
    <style name="Base.Theme.MyBagHackathon" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bag_brand_default</item>
        <item name="colorOnPrimary">@color/bag_text_on_brand</item>
        <item name="colorPrimaryContainer">@color/bag_bg_brand_subtle</item>
        <item name="colorOnPrimaryContainer">@color/bag_text_brand</item>

        <item name="colorSecondary">@color/bag_brand_default</item>
        <item name="colorOnSecondary">@color/bag_text_on_brand</item>

        <item name="colorError">@color/bag_status_danger</item>
        <item name="colorErrorContainer">@color/bag_status_danger_bg</item>
        <item name="colorOnError">@color/bag_text_on_brand</item>

        <item name="android:colorBackground">@color/bag_bg_base</item>
        <item name="colorSurface">@color/bag_bg_surface</item>
        <item name="colorOnSurface">@color/bag_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/bag_text_secondary</item>
        <item name="colorOutline">@color/bag_border_default</item>
        <item name="colorOutlineVariant">@color/bag_border_divider</item>

        <item name="android:statusBarColor">@color/bag_bg_base</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bag_bg_surface</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:textViewStyle">@style/Widget.Bag.TextView</item>

        <item name="materialButtonStyle">@style/Widget.Bag.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.Bag.TextField</item>
    </style>

    <style name="Theme.MyBagHackathon" parent="Base.Theme.MyBagHackathon" />

    <!-- 사진 전체화면 미리보기용 — 타이틀바 없이 화면을 꽉 채우는 다이얼로그 -->
    <style name="Theme.Bag.FullscreenDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- MaterialDatePicker 기본 라벤더 틴트 대신 우리 브랜드 색으로.
         선택 원(colorPrimary)만 바꿔서는 안 먹힘 — 배경 패널은 M3의
         surfaceContainer 계열 토큰을 따로 참조해서, 그것들도 다 흰색으로 눌러줘야 함. -->
    <style name="ThemeOverlay.Bag.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/bag_brand_default</item>
        <item name="colorOnPrimary">@color/bag_text_on_brand</item>
        <item name="colorPrimaryContainer">@color/bag_bg_brand_subtle</item>
        <item name="colorOnPrimaryContainer">@color/bag_text_brand</item>
        <item name="colorSecondary">@color/bag_brand_default</item>
        <item name="colorOnSecondary">@color/bag_text_on_brand</item>
        <item name="colorSurface">@color/bag_bg_base</item>
        <item name="colorOnSurface">@color/bag_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/bag_text_secondary</item>
        <item name="colorSurfaceVariant">@color/bag_bg_subtle</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorOutline">@color/bag_border_default</item>
    </style>
</resources>
