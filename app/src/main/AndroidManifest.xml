<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".app.MyBagApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyBagHackathon"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- S01 스플래시 -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- S02 로그인 -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false" />

        <!-- S04 방 만들기 -->
        <activity
            android:name=".ui.createroom.CreateRoomActivity"
            android:exported="false" />

        <!-- S05 일정 사진 업로드 -->
        <activity
            android:name=".ui.upload.ScheduleUploadActivity"
            android:exported="false" />

        <!-- S06 분석 중 -->
        <activity
            android:name=".ui.analyzing.AnalyzingActivity"
            android:exported="false" />

        <!-- S07 1차 결과 확인 -->
        <activity
            android:name=".ui.analysisresult.AnalysisResultActivity"
            android:exported="false" />

        <!-- S08 일정 검토 -->
        <activity
            android:name=".ui.review.ScheduleReviewActivity"
            android:exported="false" />

        <!-- S09 방 상세 -->
        <activity
            android:name=".ui.roomdetail.RoomDetailActivity"
            android:exported="false" />

        <!-- S15 프로필 -->
        <activity
            android:name=".ui.profile.ProfileItemsActivity"
            android:exported="false" />

        <!-- S16 알림 설정 -->
        <activity
            android:name=".ui.settings.NotificationSettingsActivity"
            android:exported="false" />

        <!-- 카카오톡 앱으로 로그인 시 인가 코드를 돌려받는 리다이렉트 액티비티 -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kakao${kakaoNativeAppKey}" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- FCM data 메시지 수신. 알림 UI 구현은 FcmMessagingService 내 TODO 참고 -->
        <service
            android:name=".service.FcmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
