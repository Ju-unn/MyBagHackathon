<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyBagHackathon"
        tools:targetApi="31">

        <!-- S01 -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MyBagHackathon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- S02 -->
        <activity android:name=".ui.login.LoginActivity" android:exported="false" />

        <!-- S03 / S13 / S14 — MainActivity hosts HomeFragment, TripArchiveFragment, ProfileFragment -->
        <activity android:name=".MainActivity" android:exported="false" />

        <!-- S04 -->
        <activity android:name=".ui.createroom.CreateRoomActivity" android:exported="false" />

        <!-- S05 -->
        <activity android:name=".ui.roomdetail.RoomDetailActivity" android:exported="false" />

        <!-- S06 -->
        <activity android:name=".ui.upload.ScheduleUploadActivity" android:exported="false" />

        <!-- S07 -->
        <activity android:name=".ui.analyzing.AnalyzingActivity" android:exported="false" />

        <!-- S08 -->
        <activity android:name=".ui.review.ScheduleReviewActivity" android:exported="false" />

        <!-- S09 -->
        <activity android:name=".ui.feedback.WeatherFeedbackActivity" android:exported="false" />

        <!-- S10 / S11 / S12 — tabbed via TabLayout + ViewPager2 -->
        <activity android:name=".ui.checklist.ChecklistActivity" android:exported="false" />

        <!-- S15 -->
        <activity android:name=".ui.settings.NotificationSettingsActivity" android:exported="false" />

    </application>

</manifest>
